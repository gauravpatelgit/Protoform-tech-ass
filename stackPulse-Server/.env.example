PORT=3005
NODE_ENV=development
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stackpulse_dev
DB_NAME_TEST=stackpulse_test
DB_USERNAME=root
DB_PASSWORD=

# At least 32 characters; generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-0000
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# Optional but recommended: raises the GitHub limit from 60 to 5000 requests/hour
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_PROFILE_TTL_MIN=60
GITHUB_TOP_K_REPOS=15
GITHUB_CONCURRENCY=5
